# Development defaults — committed, no secrets.
#
# Loaded by `npm run dev` and by any build run with `--mode development`.
# Machine-specific overrides go in `.env.development.local`, which is ignored
# by git; do not edit this file to point at your own machine.

# The API's own default port, so a fresh clone runs with no setup: start the
# API with `npm start` in ../backend and the front end finds it.
VITE_API_URL=http://localhost:8080
